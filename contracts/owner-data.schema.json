{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/owner-data.schema.json",
  "title": "Read-only owner analytics snapshot",
  "description": "Срез Метрики, Вебмастера и Search Console. Нет токена или идентификатора источника — not_checked. Сбой API — failed и пустые counts, не нулевой успех. Приватный отчёт запрашивается только после сверки счётчика или точного свойства.",
  "type": "object",
  "required": ["agent", "schema_version", "status", "checked_at", "inputs", "sources"],
  "properties": {
    "agent": {"const": "owner_data"},
    "schema_version": {"const": 1},
    "status": {"enum": ["ready", "needs_input", "failed"]},
    "checked_at": {"type": "string", "minLength": 20},
    "inputs": {
      "type": "object",
      "required": ["site", "date1", "date2", "metrika_counter", "gsc_property", "output"],
      "properties": {
        "site": {"type": "string", "minLength": 1},
        "date1": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "date2": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "metrika_counter": {"type": ["string", "null"], "pattern": "^[1-9][0-9]{0,19}$"},
        "gsc_property": {"type": ["string", "null"], "minLength": 1},
        "output": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "period": {
      "type": "object",
      "required": ["date1", "date2"],
      "properties": {
        "date1": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "date2": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "source",
        "property",
        "period",
        "checked_at",
        "status",
        "reason",
        "quota",
        "counts",
        "data"
      ],
      "properties": {
        "source": {"enum": ["yandex_metrika", "yandex_webmaster", "gsc"]},
        "property": {"type": ["string", "null"]},
        "period": {"$ref": "#/$defs/period"},
        "checked_at": {"type": "string", "minLength": 20},
        "status": {"enum": ["ready", "not_checked", "failed"]},
        "reason": {"type": ["string", "null"]},
        "quota": {"type": "null"},
        "counts": {"type": ["object", "null"]},
        "data": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "ready"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "property": {"type": "string", "minLength": 1},
              "reason": {"type": "null"},
              "counts": {"type": "object"},
              "data": {"type": "object"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"enum": ["not_checked", "failed"]}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason": {"type": "string", "minLength": 1},
              "counts": {"type": "null"},
              "data": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
